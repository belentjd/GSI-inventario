---
import StatusPanel from '../StatusPanel.astro';
---
<div class="mb-5">
  <StatusPanel />
</div>

<div class="mb-5 flex flex-wrap items-end justify-between gap-4">
  <p class="text-sm text-slate-400"><strong id="objects-count" class="text-xl text-white">—</strong> objetos</p>
  <label class="text-sm text-slate-400">Buscar objetos
    <input id="objects-search" class="mt-1 block w-64 max-w-full border border-[#34495b] bg-[#0c1723] px-3 py-2 text-slate-100 outline-none placeholder:text-slate-500 focus:border-accent" type="search" placeholder="Objeto, descripción, puesto…" />
  </label>
</div>

<div class="panel overflow-hidden"><div class="table-wrap">
  <table class="inventory-table text-sm">
    <thead><tr><th>ID</th><th>Objeto</th><th>Descripción</th><th>Puesto</th></tr></thead>
    <tbody id="objects-body"><tr><td colspan="4">Cargando objetos…</td></tr></tbody>
  </table>
</div></div>
<p id="source-note" class="mt-3 text-sm text-rose-300" aria-live="polite"></p>
<p id="last-updated" class="mt-6 text-right text-xs text-slate-500"></p>

<script>import '../../scripts/objects.ts';</script>
