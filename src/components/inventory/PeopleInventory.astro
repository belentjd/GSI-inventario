---
import StatusPanel from '../StatusPanel.astro';
---
<div class="mb-5">
  <StatusPanel />
</div>


<div class="mb-5 flex flex-wrap items-end justify-between gap-4">
  <p class="text-sm text-slate-400"><strong id="people-count" class="text-xl text-white">—</strong> personas · <strong id="seats-count" class="text-xl text-white">—</strong> de 12 puestos ocupados</p>
  <label class="text-sm text-slate-400">Buscar personas
    <input id="people-search" class="mt-1 block w-64 max-w-full border border-[#34495b] bg-[#0c1723] px-3 py-2 text-slate-100 outline-none placeholder:text-slate-500 focus:border-accent" type="search" placeholder="Nombre, tutor, puesto…" />
  </label>
</div>

<div class="panel overflow-hidden"><div class="table-wrap">
  <table class="inventory-table text-sm">
    <thead><tr><th>ID</th><th>Persona</th><th>Tutor</th><th>Puesto</th><th>Titulación</th><th>Estado</th></tr></thead>
    <tbody id="people-body"><tr><td colspan="6">Cargando personas…</td></tr></tbody>
  </table>
</div></div>
<p id="source-note" class="mt-3 text-sm text-rose-300" aria-live="polite"></p>
<p id="last-updated" class="mt-6 text-right text-xs text-slate-500"></p>

<script>import '../../scripts/people.ts';</script>
